@startuml
left to right direction
skinparam packageStyle rectangle

actor "Docente" as Docente
actor "Técnico de Qualidade" as Tecnico
actor "Dirigente" as Dirigente
actor "Aluno" as Aluno

rectangle "Sistema de Gestão de Presenças" {
usecase "UC1: Criar pauta de presenças" as UC1
usecase "UC2: Registar presenças na pauta" as UC2
usecase "UC3: Encerrar e gerar histórico semanal" as UC3
usecase "UC4: Consultar e analisar assiduidade" as UC4
usecase "UC5: Analisar utilização do sistema (Data Analytics)" as UC5
}

' Associações do Docente
Docente -- UC1
Docente -- UC2
Docente -- UC3

' Associações do Técnico de Qualidade e Dirigente
Tecnico -- UC4
Tecnico -- UC5
Dirigente -- UC4

' Associações do Aluno (linhas contínuas em UML para relação Ator-UC)
Aluno -- UC1
Aluno -- UC2

' Encadeamento de dados entre os casos de uso
/'1'/ UC1 ..> UC2 : <<fornece pauta>>
/'2'/ UC2 ..> UC3 : <<fornece presenças>>
/'3'/ UC3 ..> UC4 : <<fornece dados consolidados>>
@enduml